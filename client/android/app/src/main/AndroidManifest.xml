<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Microphone for voice recording. The 'record' plugin adds this automatically,
         but we list it explicitly so the user sees the permission in app info. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Recording files use the user-selected Documents/Tangent folder through
         Android's Storage Access Framework. No broad storage permission is used. -->

    <!-- Internet for syncing with the Tangent server. -->
    <!-- Required on Android 12+ (API 31) to enumerate and select a Bluetooth
         headset microphone. Without it AudioManager returns a silently EMPTY
         input-device list rather than an error, so the headset never appears
         in the picker. Recording through the built-in mic does not need it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required on Android 13+ (API 33) to show the "Transcribing" notice in
         the shade while a recording is being transcribed. Without it the post
         silently no-ops: no error, nothing in the shade. The permission is
         requested at the moment the first notification would appear rather
         than at launch, so the prompt arrives with its reason visible.

         This is a plain dismissible notification, NOT a foreground service:
         it reports work in progress, it does not keep that work alive, so no
         FOREGROUND_SERVICE permission is declared. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact due-time alarms. SCHEDULE_EXACT_ALARM remains user-revocable on
         Android 12+ and is requested only when the user first sets a due
         date/time. USE_EXACT_ALARM is deliberately not used: it is a
         restricted auto-grant and would bypass that point-of-use posture.
         RECEIVE_BOOT_COMPLETED lets the plugin re-arm persisted schedules. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Home-screen widget taps arrive as VIEW tangent://notebook/<id>.
                 Internal-only scheme: no autoVerify, no http, nothing another
                 app is likely to fire in anger. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tangent" android:host="notebook"/>
            </intent-filter>
            <!-- Hands-free record spine (spec 2026-09-28): the 1x1 mic
                 widget, the launcher "Record" shortcut and the Assistant
                 App Action all fire VIEW tangent://record. Same internal
                 scheme, no autoVerify. showWhenLocked/turnScreenOn are NOT
                 declared here: MainActivity sets them at runtime only for
                 this intent (H3), never for a normal launch. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tangent" android:host="record"/>
            </intent-filter>
            <!-- Completion notifications (spec 2026-09-28 N2): a
                 "Transcribed" / "Notes ready" tap opens the recording as
                 VIEW tangent://dump/<id>. Same internal scheme, same
                 LaunchRouter cold/warm handling as the notebook widget. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tangent" android:host="dump"/>
            </intent-filter>
            <!-- Static launcher shortcut + App Actions capability. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>
        <!-- 1x1 "start a brain dump" mic widget. No config activity: every
             instance fires tangent://record. -->
        <receiver
            android:name=".widget.RecordWidgetProvider"
            android:exported="false"
            android:label="Record">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_info"/>
        </receiver>
        <!-- 2x2 "open this notebook" home-screen widget. -->
        <receiver
            android:name=".widget.NotebookWidgetProvider"
            android:exported="false"
            android:label="Notebook">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_notebook_info"/>
        </receiver>
        <activity
            android:name=".widget.NotebookWidgetConfigActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>
        <!-- Debug-log attachments are served from cache/debug_logs only. The
             recipient gets a temporary read grant; no storage permission or
             file:// URI is used. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debug_logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_log_paths" />
        </provider>
        <!-- flutter_local_notifications: delivers the scheduled reminder and
             restores pending schedules after a reboot. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Required for the background "Mark done" notification action. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Package visibility for the addressed email composer and the final
             plain-file share fallback on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
