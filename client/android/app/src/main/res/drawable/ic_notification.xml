<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon.

     Android masks a status-bar icon to a flat silhouette: every opaque pixel
     is repainted a single system colour, so the purple dot CANNOT survive in
     the drawable itself. The brand colour is carried by the notification's
     accent colour field instead, which is the only channel the platform
     leaves under the app's control.

     Drawn as the waveform alone, at 24dp with the standard 2dp padding. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFFFF">

    <!-- Bars, rounded ends, matching the launcher geometry. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,55.5 a3.5,3.5 0 0,1 7,0 v9 a3.5,3.5 0 0,1 -7,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,43.5 a3.5,3.5 0 0,1 7,0 v33 a3.5,3.5 0 0,1 -7,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,31.5 a3.5,3.5 0 0,1 7,0 v57 a3.5,3.5 0 0,1 -7,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,47.5 a3.5,3.5 0 0,1 7,0 v25 a3.5,3.5 0 0,1 -7,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M72,57.5 a3.5,3.5 0 0,1 7,0 v5 a3.5,3.5 0 0,1 -7,0 z" />

    <!-- The dot, above the waveform. Silhouetted like everything else. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,8 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />
</vector>
