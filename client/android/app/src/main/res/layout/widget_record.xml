<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 record tile in the launcher icon's palette (Jeff): Blackout
     #141719 disc, signal-lime #D4FF47 mic, purple #9B2594 dot above it.
     8dp margin so the disc has breathing room in a 1x1 cell on Samsung
     launchers; the inner padding keeps the glyph at the button's ratio
     (64 in 120). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_record_root"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_margin="@dimen/widget_record_margin"
      android:padding="@dimen/widget_record_padding"
      android:background="@drawable/widget_record_bg"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_mic"
      android:contentDescription="@string/widget_record_content_description" />
</FrameLayout>
