<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcut "Record" (long-press the app icon), firing the
     tangent://record spine — the same intent as the 1x1 widget.
     The Google Assistant App Action that shipped in 1.31.0 was REMOVED in
     1.31.1: Assistant only fulfils custom intents for apps it has indexed
     from the Play Store, so on a sideloaded build it said "Starting
     recording in Tangent" and delivered nothing (Fold logcat 07:58-08:02,
     no intent reached the app). A confirmation with no action is worse
     than no voice path at all. Re-add the <capability> only alongside a
     Play listing. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
      android:shortcutId="record"
      android:enabled="true"
      android:icon="@drawable/ic_shortcut_record"
      android:shortcutShortLabel="@string/shortcut_record_short"
      android:shortcutLongLabel="@string/shortcut_record_long">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="dev.tangent.tangent"
        android:targetClass="dev.tangent.tangent.MainActivity"
        android:data="tangent://record" />
  </shortcut>
</shortcuts>
