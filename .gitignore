# ── Python (server side, will live under server/) ─────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Whisper / model artifacts ─────────────────────────────────
# Model weights are downloaded at runtime. Keep them OUT of git.
*.bin
*.gguf
*.ggml
models/*.pt
models/*.onnx
models/**/*.bin

# ── Docker ────────────────────────────────────────────────────
# Keep compose files tracked, ignore runtime artifacts.
**/.dockerignore.bak
docker-compose.override.yml

# ── Local config / secrets ────────────────────────────────────
.env
.env.local
.env.*.local
*.local
secrets/
config/local.yaml

# ── Recordings / user data (NEVER commit) ────────────────────
# These belong to the end user. The server should store them
# under a path the user owns, not under this repo.
# Note: lib/data/ in the client is Dart source code, NOT runtime data.
/data
/data/
server/data/
recordings/
uploads/
*.wav
*.opus
*.m4a
*.mp3

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── OS junk ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editor / IDE ──────────────────────────────────────────────
*.swp
*.swo
*~
.vscode/settings.json
.idea/workspace.xml
# SDD orchestration artifacts (skill-managed scratch)
.superpowers/sdd/

# Local git worktrees used for isolated implementation branches
.worktrees/

